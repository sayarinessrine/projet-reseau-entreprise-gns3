# /etc/netplan/50-cloud-init.yaml
# VM Ubuntu-Server (VirtualBox) - IP fixe permanente (serveur NFS)
#
# enp0s3 = Adaptateur 1 (NAT, accès Internet de la VM elle-même)
# enp0s8 = Adaptateur 2 (Host-Only, branché sur Cloud1 -> RS dans GNS3)

network:
  version: 2
  ethernets:
    enp0s3:
      dhcp4: true
    enp0s8:
      dhcp4: false
      addresses:
        - 192.168.8.2/25
      routes:
        - to: default
          via: 192.168.8.1
          metric: 50
