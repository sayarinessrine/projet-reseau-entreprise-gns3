! =========================================
! R-Internet - Passerelle WAN simulée
! =========================================

enable
configure terminal

interface FastEthernet0/0
 ip address 192.168.8.142 255.255.255.252
 no shutdown
 exit

interface Loopback0
 ip address 8.8.4.4 255.255.255.255
 exit

router ospf 1
 network 192.168.8.140 0.0.0.3 area 0
 network 8.8.4.4 0.0.0.0 area 0
 exit

end
write memory
